{
  "name": "quantumsure-utils",
  "version": "0.1.0",
  "description": "Shared quantum-resistant crypto utilities for QuantumSure (ML-KEM-1024, ChaCha20, key wrapping).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quantum",
    "post-quantum",
    "ml-kem",
    "kyber",
    "chacha20",
    "quantumsure"
  ],
  "author": "QuantumSure",
  "license": "MIT",
  "dependencies": {
    "mlkem": "^2.3.1",
    "js-chacha20": "^1.1.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
